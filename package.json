{
  "name": "component-generator",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "format": "prettier  --list-different --write .",
    "generate": "nuxt generate",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "test": "exit 0",
    "typecheck": "nuxi typecheck",
    "verify": "npm run format && npm run lint:fix && npm run typecheck && npm test"
  },
  "packageManager": "pnpm@10.15.1",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.61.0",
    "@nuxt/eslint": "1.9.0",
    "@nuxt/fonts": "0.11.4",
    "@nuxt/icon": "2.0.0",
    "@nuxt/image": "1.11.0",
    "@nuxtjs/seo": "3.1.0",
    "@vueuse/nuxt": "13.9.0",
    "nuxt": "^4.1.1",
    "shiki": "^3.12.2",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@iconify-json/uil": "^1.2.3",
    "@lttr/nuxt-config-eslint": "^0.3.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vue-tsc": "^3.0.6"
  }
}
